#:kivy 2.0

# NOTE: RootScreen is a Screen, which is a RelativeLayout under the hood.
# RelativeLayout does NOT have "orientation"/"padding"/"spacing" properties,
# so setting them directly on the Screen used to do nothing -- every child
# widget silently fell back to filling the whole screen (size_hint 1, 1),
# which is why labels/inputs/buttons all rendered stacked on top of each
# other. The fix is to give every screen exactly one real BoxLayout child
# and put all the actual content inside *that*.

<RootScreen>:
    canvas.before:
        Color:
            rgba: 0.07, 0.08, 0.11, 1
        Rectangle:
            pos: self.pos
            size: self.size


<HeaderBar@BoxLayout>:
    size_hint_y: None
    height: dp(40)
    Label:
        text: "Flash Anzan · SRS"
        font_size: "20sp"
        bold: True
        color: 0.9, 0.9, 0.95, 1
        halign: "left"
        valign: "middle"
        text_size: self.size


<BigButton@Button>:
    background_normal: ""
    background_color: 0.20, 0.45, 0.85, 1
    color: 1, 1, 1, 1
    font_size: "18sp"
    size_hint_y: None
    height: dp(52)


<BugReportPopup@Popup>:
    title: "Round stopped"
    size_hint: 0.88, 0.55
    auto_dismiss: False
    BoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(12)
        Label:
            text: "Want to report a bug or anything that went wrong?"
            color: 0.85, 0.85, 0.9, 1
            size_hint_y: None
            height: dp(44)
            text_size: self.width, None
            halign: "center"
        TextInput:
            id: bug_text
            hint_text: "Describe the issue (optional)"
            multiline: True
            background_color: 0.15, 0.16, 0.2, 1
            foreground_color: 1, 1, 1, 1
            hint_text_color: 0.6, 0.62, 0.68, 1
            cursor_color: 1, 1, 1, 1
            selection_color: 0.20, 0.45, 0.85, 0.5
            padding: dp(12), dp(12)
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(12)
            BigButton:
                text: "Send report"
                on_release: app.submit_bug_report(bug_text.text); root.dismiss()
            BigButton:
                text: "Just stop"
                background_color: 0.30, 0.30, 0.35, 1
                on_release: root.dismiss()


<SettingsScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(12)

        HeaderBar:

        ScrollView:
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(18)
                padding: dp(4), dp(8)

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(64)
                    Label:
                        text: "How many numbers per round (2-50):"
                        color: 0.85, 0.85, 0.9, 1
                        size_hint_y: None
                        height: dp(24)
                    TextInput:
                        id: term_input
                        text: "5"
                        input_filter: "int"
                        multiline: False
                        font_size: "18sp"
                        size_hint_y: None
                        height: dp(40)
                        halign: "center"
                        background_color: 0.96, 0.97, 0.99, 1
                        foreground_color: 0.06, 0.06, 0.08, 1
                        cursor_color: 0.20, 0.45, 0.85, 1
                        selection_color: 0.20, 0.45, 0.85, 0.4

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(64)
                    Label:
                        text: "Digits per number (1-6):"
                        color: 0.85, 0.85, 0.9, 1
                        size_hint_y: None
                        height: dp(24)
                    TextInput:
                        id: digit_input
                        text: "1"
                        input_filter: "int"
                        multiline: False
                        font_size: "18sp"
                        size_hint_y: None
                        height: dp(40)
                        halign: "center"
                        background_color: 0.96, 0.97, 0.99, 1
                        foreground_color: 0.06, 0.06, 0.08, 1
                        cursor_color: 0.20, 0.45, 0.85, 1
                        selection_color: 0.20, 0.45, 0.85, 0.4

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(64)
                    Label:
                        text: "Flash speed in ms per number (100-10000):"
                        color: 0.85, 0.85, 0.9, 1
                        size_hint_y: None
                        height: dp(24)
                    TextInput:
                        id: speed_input
                        text: "800"
                        input_filter: "int"
                        multiline: False
                        font_size: "18sp"
                        size_hint_y: None
                        height: dp(40)
                        halign: "center"
                        background_color: 0.96, 0.97, 0.99, 1
                        foreground_color: 0.06, 0.06, 0.08, 1
                        cursor_color: 0.20, 0.45, 0.85, 1
                        selection_color: 0.20, 0.45, 0.85, 0.4

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(64)
                    Label:
                        text: "Bias toward hard patterns (1-20x):"
                        color: 0.85, 0.85, 0.9, 1
                        size_hint_y: None
                        height: dp(24)
                    TextInput:
                        id: bias_input
                        text: "3.0"
                        input_filter: "float"
                        multiline: False
                        font_size: "18sp"
                        size_hint_y: None
                        height: dp(40)
                        halign: "center"
                        background_color: 0.96, 0.97, 0.99, 1
                        foreground_color: 0.06, 0.06, 0.08, 1
                        cursor_color: 0.20, 0.45, 0.85, 1
                        selection_color: 0.20, 0.45, 0.85, 0.4

                BigButton:
                    text: "Start round"
                    on_release: root.start_round()

                BigButton:
                    text: "View stats"
                    background_color: 0.30, 0.30, 0.35, 1
                    on_release: root.manager.current = "stats"


<FlashScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(12)

        HeaderBar:

        Widget:
            size_hint_y: 0.15

        Label:
            id: flash_label
            text: ""
            font_size: "96sp"
            bold: True
            color: 1, 1, 1, 1
            halign: "center"
            valign: "middle"

        Label:
            id: progress_label
            text: ""
            font_size: "16sp"
            color: 0.6, 0.6, 0.7, 1
            size_hint_y: None
            height: dp(30)

        Widget:
            size_hint_y: 0.15

        BigButton:
            text: "Stop"
            background_color: 0.55, 0.22, 0.22, 1
            on_release: root.stop_round()


<AnswerScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(12)

        HeaderBar:

        Widget:
            size_hint_y: 0.1

        Label:
            text: "What's the total?"
            font_size: "22sp"
            color: 0.85, 0.85, 0.9, 1
            size_hint_y: None
            height: dp(36)

        TextInput:
            id: answer_input
            hint_text: "Enter your answer"
            input_filter: "int"
            font_size: "32sp"
            multiline: False
            size_hint_y: None
            height: dp(64)
            halign: "center"
            padding_y: [dp(16), dp(16)]
            background_color: 0.96, 0.97, 0.99, 1
            foreground_color: 0.06, 0.06, 0.08, 1
            hint_text_color: 0.45, 0.45, 0.5, 1
            cursor_color: 0.20, 0.45, 0.85, 1
            selection_color: 0.20, 0.45, 0.85, 0.4
            on_text_validate: root.submit()

        BigButton:
            text: "Submit"
            on_release: root.submit()

        Widget:


<ResultScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(12)

        HeaderBar:

        Widget:
            size_hint_y: 0.1

        Label:
            id: result_label
            text: ""
            font_size: "40sp"
            bold: True
            size_hint_y: None
            height: dp(60)

        Label:
            id: detail_label
            text: ""
            font_size: "18sp"
            color: 0.8, 0.8, 0.85, 1
            size_hint_y: None
            height: dp(80)
            halign: "center"
            text_size: self.width, None

        Label:
            id: pattern_label
            text: ""
            font_size: "14sp"
            color: 0.55, 0.55, 0.65, 1
            size_hint_y: None
            height: max(dp(24), self.texture_size[1])
            halign: "center"
            text_size: self.width, None

        BigButton:
            text: "Next round"
            on_release: root.next_round()

        BigButton:
            text: "Back to settings"
            background_color: 0.30, 0.30, 0.35, 1
            on_release: root.manager.current = "settings"

        Widget:


<StatsScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(12)

        HeaderBar:

        Label:
            text: "Digit weak spots"
            bold: True
            size_hint_y: None
            height: dp(24)
            color: 0.8, 0.8, 0.9, 1

        GridLayout:
            id: digit_grid
            cols: 10
            size_hint_y: None
            height: dp(56)
            spacing: dp(2)

        Label:
            text: "Column accuracy"
            bold: True
            size_hint_y: None
            height: dp(24)
            color: 0.8, 0.8, 0.9, 1

        GridLayout:
            id: position_grid
            cols: 8
            size_hint_y: None
            height: dp(56)
            spacing: dp(2)

        Label:
            text: "Facts"
            bold: True
            size_hint_y: None
            height: dp(24)
            color: 0.8, 0.8, 0.9, 1

        ScrollView:
            GridLayout:
                id: stats_grid
                cols: 4
                size_hint_y: None
                height: self.minimum_height
                row_default_height: dp(28)
                spacing: dp(2)

        BigButton:
            text: "Back"
            background_color: 0.30, 0.30, 0.35, 1
            size_hint_y: None
            height: dp(48)
            on_release: root.manager.current = "settings"
